<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.gesturereplayzh">
    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_master"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GestureReplay">

        <activity
            android:name=".RecordActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.GestureReplay.Transparent" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".GestureAccessibilityService"
            android:description="@string/accessibility_description"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
