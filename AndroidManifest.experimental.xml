<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.gesturereplayzh.autoexperimental"
    android:versionCode="13"
    android:versionName="0.8.5-experimental">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="36" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="全自動辨識實驗版"
        android:supportsRtl="true"
        android:theme="@style/Theme.GestureReplay">

        <activity
            android:name="com.example.gesturereplayzh.RecordActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.GestureReplay.Transparent" />

        <activity
            android:name="com.example.gesturereplayzh.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.example.gesturereplayzh.GestureAccessibilityService"
            android:description="@string/accessibility_description_experimental"
            android:exported="true"
            android:label="@string/accessibility_label_experimental"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_experimental" />
        </service>
    </application>
</manifest>
